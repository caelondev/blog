#!/usr/bin/env bash
set -euo pipefail

BRANCH="pages"

echo "+-----------------------------------+"
echo "|  blog.caelondev - deploy script   |"
echo "+-----------------------------------+"
echo ""

echo "[1/3] generating rss.xml..."
./scripts/generate-rss.mjs

if ! git diff --quiet -- public/rss.xml; then
  echo "  -> rss.xml changed, committing on current branch"
  git add public/rss.xml
  git commit -q -m "chore: update rss.xml"
else
  echo "  -> rss.xml unchanged"
fi

if ! git diff --quiet -- public/slug.json; then
  echo "  -> slug.json changed, committing on current branch"
  git add public/slug.json
  git commit -q -m "chore: update slug.json"
else
  echo "  -> rss.xml unchanged"
fi

echo "[2/3] resetting '$BRANCH' to current branch (wiping old history)..."
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
git checkout -B "$BRANCH"
git checkout "$CURRENT_BRANCH"

echo "[3/3] pushing..."
git push origin "$BRANCH" -f

echo ""
echo "[ OK ] pushed to '$BRANCH' — Cloudflare will build it."
